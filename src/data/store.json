    {
      "id": "blue_dibu_ciego",
      "categoryId": "blue",
      "name": {
        "es": "Dibu-ciego"
      },
      "activity": {
        "es": "Para ganar este Dibu-ciego, el equipo elige a un jugador. Debe lograr que su equipo adivine la respuesta del dorso dibujando con los ojos cerrados. No se puede abrir los ojos, usar letras o símbolos, ni hablar. Se lee la pista, se entrega la tarjeta y se voltea el reloj."
      },
      "mode": "team"
    },
    {
      "id": "blue_molde_mudo",
      "categoryId": "blue",
      "name": {
        "es": "Molde mudo"
      },
      "activity": {
        "es": "Para ganar este Molde mudo, el equipo elige a un jugador. Debe lograr que su equipo adivine la respuesta del dorso modelando con masa. No se puede hablar ni hacer gestos (se puede mover la masa). Se lee la pista, se entrega la tarjeta y se voltea el reloj."
      },
      "mode": "team"
    },
    {
      "id": "blue_pinta_silencio",
      "categoryId": "blue",
      "name": {
        "es": "Pinta-silencio"
      },
      "activity": {
        "es": "Para ganar este Pinta-silencio, el equipo elige a un jugador. Debe lograr que su equipo adivine la respuesta del dorso pintando sin hablar. No se pueden usar letras ni símbolos. Se lee la pista, se entrega la tarjeta y se voltea el reloj."
      },
      "mode": "team"
    },
    {
      "id": "blue_todos_juegan",
      "categoryId": "blue",
      "name": {
        "es": "Todos juegan"
      },
      "activity": {
        "es": "Todos los equipos juegan al mismo tiempo. El equipo ganador recibe un tiro extra y avanza. Si el equipo que sacó la tarjeta no gana, debe sacar otra tarjeta de la misma categoría."
      },
      "mode": "all-play"
    },
